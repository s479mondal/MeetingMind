# =============================================================================
# MeetingMind - Environment Configuration Template
# =============================================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values in .env
# 3. Never commit .env — it's already in .gitignore
# =============================================================================


# MongoDB Atlas
MONGODB_USERNAME=your_atlas_username
MONGODB_PASSWORD=your_atlas_password
MONGODB_CLUSTER=cluster0.xxxxxxx.mongodb.net
MONGODB_DATABASE=meetingmind
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority&appName=Cluster0

# Spring Boot
SERVER_PORT=8080

# OpenAI API  (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_LLM_MODEL=gpt-4o-mini
ASR_PROVIDER=openai-whisper
# ASR_PROVIDER=mock   <-- use this to run without OpenAI

# Frontend (Vite)
VITE_API_URL=http://localhost:8080/api
